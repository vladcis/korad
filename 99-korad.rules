# KORAD KA3005P/PS (Winbond Virtual COM 0416:5011)
# - ModemManager will not probe it as a modem (otherwise it sends AT commands and disrupts communication)
# - stable name /dev/korad
# Installation: sudo cp 99-korad.rules /etc/udev/rules.d/ && sudo udevadm control --reload && sudo udevadm trigger
ATTRS{idVendor}=="0416", ATTRS{idProduct}=="5011", ENV{ID_MM_DEVICE_IGNORE}="1", MODE="0660", GROUP="dialout", SYMLINK+="korad"
